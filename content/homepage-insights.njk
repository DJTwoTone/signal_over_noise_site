---
permalink: /homepage-insights.html
---
<div class="insight-card-grid">
  {% for post in collections.insights %}
    {% if loop.index <= 2 %}
      <article class="card insight-card">
        {% if post.data.ogImage %}
          <a class="insight-card__image" href="{{ post.url }}" aria-label="Read {{ post.data.title }}">
            <img src="{{ post.data.ogImage.src }}" alt="{{ post.data.ogImage.alt }}" width="1200" height="630" loading="lazy" decoding="async">
          </a>
        {% endif %}
        <div class="insight-card__body">
          <p class="eyebrow">{{ post.data.category }}</p>
          <h3 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p class="card-copy">{{ post.data.description }}</p>
          <p class="insight-meta"><time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time></p>
          <a class="text-link" href="{{ post.url }}">Read the article</a>
        </div>
      </article>
    {% endif %}
  {% endfor %}
</div>
