---
permalink: /insights/
title: The Insight Desk | Signal over Noise
description: Practical presentation insight for moments that matter.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="{{ 'noindex, nofollow' if insightsPreview else 'index, follow' }}">
    <link rel="canonical" href="https://signal-over-noise.coach/insights/">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://signal-over-noise.coach/insights/">
    <meta property="og:image" content="https://signal-over-noise.coach/img/signal-over-noise-square-logo.png">
    <meta property="og:image:alt" content="Signal over Noise logo">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://signal-over-noise.coach/img/signal-over-noise-square-logo.png">
    <meta name="theme-color" content="#0b2d53">
    <link rel="icon" href="/img/brand-marks/favicon-rounded-square.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Mulish:wght@400;500;700&family=Source+Code+Pro:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css">
    <script src="/assets/site.js" defer></script>
  </head>
  <body data-site-root="../" data-page="insights" data-origin-page="/insights/" data-source-context="insights-index">
    <a href="#main" class="skip-link">Skip to main content</a>
    <div data-site-header></div>
    <main id="main" class="page">
      <section class="section insight-hero">
        <div class="shell section__stack">
          <div class="section__intro insight-hero__copy">
            <p class="eyebrow">The Insight Desk</p>
            <h1 class="hero-title">Practical presentation insight for moments that matter.</h1>
            <p class="section-copy">Clear, useful guidance for people presenting in English, across languages, or in rooms where the stakes are higher than the slide count suggests.</p>
            <p class="section-copy">Explore how to improve the message, deck, script, and delivery, then decide what actually needs fixing.</p>
          </div>
        </div>
      </section>

      <section class="section section--muted">
        <div class="shell section__stack">
          {% if collections.insights.length %}
            <div class="insight-card-grid">
              {% for post in collections.insights %}
                <article class="card insight-card">
                  {% if post.data.ogImage %}
                    <a class="insight-card__image" href="{{ post.url }}" aria-label="Read {{ post.data.title }}">
                      <img src="{{ post.data.ogImage.src }}" alt="{{ post.data.ogImage.alt }}" width="1200" height="630" loading="lazy" decoding="async">
                    </a>
                  {% endif %}
                  <div class="insight-card__body">
                    <p class="eyebrow">{{ post.data.category }}</p>
                    <h2 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                    <p class="card-copy">{{ post.data.description }}</p>
                    <p class="insight-meta"><time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time></p>
                    <a class="text-link" href="{{ post.url }}">Read the article</a>
                  </div>
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </section>
    </main>
    <div data-site-footer></div>
  </body>
</html>
